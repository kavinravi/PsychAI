# Copy this file to secrets.toml and fill in your actual credentials
# DO NOT commit secrets.toml to version control!

# Supabase Database Configuration (REQUIRED)
# Get these from: https://app.supabase.com/ -> Project Settings -> API
[supabase]
url = "https://your-project-id.supabase.co"
key = "your-supabase-anon-or-service-role-key"

# Google OAuth Configuration (optional)
# Get these from: https://console.cloud.google.com/
[google_oauth]
client_id = "your-google-client-id.apps.googleusercontent.com"
client_secret = "your-google-client-secret"
redirect_uri = "http://localhost:8501"  # Change to your production URL when deploying

# Environment Configuration
[environment]
session_timeout_hours = 24
enable_google_auth = false  # Set to true once OAuth is configured

# Hugging Face Hub (REQUIRED for chat inference)
# Token: https://huggingface.co/settings/tokens (read access is enough for
# inference; need write access only when running scripts/merge_and_push.py).
[huggingface]
token = "hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Merged (LoRA folded into base) model. Created by scripts/merge_and_push.py.
model = "kavin-ravi/qwen3-8b-psychai-merged"
# "auto" lets HF pick a provider; or pin "hf-inference" / "together" / "novita" / "replicate".
provider = "auto"
# Override with a dedicated Inference Endpoint URL if you have one.
# endpoint_url = "https://xxxx.endpoints.huggingface.cloud"
max_new_tokens = 512
temperature = 0.7
top_p = 0.9

